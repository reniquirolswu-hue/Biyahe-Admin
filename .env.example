DB_HOST=localhost       # or 127.0.0.1 (or host.docker.internal / IP if hosted remotely)
DB_PORT=5432            # Default PostgreSQL port
DB_NAME=your_db_name    # The database name you created in pgAdmin 4
DB_USER=postgres         # Your PostgreSQL superuser (usually 'postgres')
DB_PASS=your_postgres_password  # The password set when installing PostgreSQL